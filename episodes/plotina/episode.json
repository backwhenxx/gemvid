{
  "title": "Как построить плотину",
  "music": false,
  "whisper": "medium",
  "captionStyle": "word",
  "autoOutro": false,
  "demoVoice": true,
  "cover": {"lines": ["Как построить", "*плотину*"], "sub": "которую не смоет к утру", "dam": {"core": 1, "grout": 1, "level": 6.3, "spill": 1, "spillWater": true, "baffles": 1, "ladder": 1, "turbine": 1, "road": 1, "fence": 1, "cam": [{"pos": [-6, 12, 40], "look": [2, 1, -6]}, {"pos": [-6, 12, 40], "look": [2, 1, -6]}]}},
  "scenes": [
    {"type": "dam", "say": "Насыпь землю поперёк реки — и у тебя плотина.",
     "props": {"drop": true, "level": 0.6, "cam": ["front", "frontLow"]}},
    {"type": "dam", "say": "Но вода поднимается за ней, переливается через верх и к утру смывает всю кучу.",
     "props": {"cont": true, "dam": ["pile", "washed"], "damDur": 1, "erode": true, "level": [0.6, 3.6], "levelDur": 0.45, "overflow": [0, 1], "overflowDelay": 0.25, "overflowDur": 0.3, "cam": ["frontLow", "frontClose"]}},
    {"type": "dam", "say": "Поэтому её делают широкой внизу и узкой наверху: чем глубже вода, тем сильнее она давит.",
     "props": {"cont": true, "dam": ["washed", "final"], "damDur": 0.5, "level": [3.6, 6.3], "levelDur": 0.9, "arrows": [0, 1], "arrowsDelay": 0.65, "cam": ["frontClose", "wide"]}},
    {"type": "dam", "say": "Каждые десять метров глубины — это ещё вес всего воздуха над нами.",
     "props": {"cont": true, "level": 6.3, "arrows": 1, "banner": "+1 атмосфера\nкаждые 10 метров", "bannerAt": 0.15, "cam": ["wide", "upstreamFace"], "camDur": 0.6}},
    {"type": "dam", "say": "Но земля впитывает воду, и она просачивается прямо сквозь плотину.",
     "props": {"cont": true, "level": 6.3, "seep": "through", "cam": ["upstreamFace", "core"], "camDur": 0.5}},
    {"type": "dam", "say": "Поэтому в середину закапывают стену из сырой глины — так плотно, что вода не проходит.",
     "props": {"cont": true, "level": 6.3, "core": [0, 1], "seep": "core", "cam": ["core", "core"]}},
    {"type": "dam", "say": "Это ядро. Но теперь вода пробирается снизу — по трещинам в скале.",
     "props": {"cont": true, "level": 6.3, "core": 1, "seep": "under", "cam": ["core", "under"], "camDur": 0.6}},
    {"type": "dam", "say": "Поэтому в скале бурят глубокие скважины и закачивают в них цемент.",
     "props": {"cont": true, "level": 6.3, "core": 1, "grout": [0, 1], "seep": "under", "cam": ["under", "deep"]}},
    {"type": "dam", "say": "Это цементационная завеса. Но весной тает снег, озеро поднимается —",
     "props": {"cont": true, "core": 1, "grout": 1, "seep": "underBlocked", "level": [6.3, 7.35], "levelDelay": 0.45, "levelDur": 0.5, "cam": ["deep", "front"], "camDur": 0.8}},
    {"type": "dam", "say": "и вода снова идёт через верх. Именно так плотины гибнут чаще всего.",
     "props": {"cont": true, "core": 1, "grout": 1, "level": 7.35, "overflow": [0, 1], "overflowDur": 0.4, "debris": true, "debrisZ": -2, "banner": "№1 причина\nгибели плотин", "bannerAt": 0.45, "cam": ["front", "overflow"], "camDur": 0.7}},
    {"type": "dam", "say": "Не от трещин, а от перелива. Поэтому сбоку заливают бетонную горку,",
     "props": {"cont": true, "core": 1, "grout": 1, "level": [7.35, 6.3], "levelDelay": 0.5, "levelDur": 0.4, "overflow": [1, 0], "overflowDelay": 0.5, "overflowDur": 0.4, "spill": [0, 1], "spillDelay": 0.45, "spillDur": 0.45, "cam": ["overflow", "spillTop"], "camDur": 0.6}},
    {"type": "dam", "say": "чтобы лишняя вода уходила в обход. Это водосброс. Но вода летит вниз так быстро,",
     "props": {"cont": true, "core": 1, "grout": 1, "level": 6.3, "spill": 1, "spillWater": true, "cam": ["spillTop", "spillBottom"]}},
    {"type": "dam", "say": "что вымывает яму внизу и начинает подъедать плотину.",
     "props": {"cont": true, "core": 1, "grout": 1, "level": 6.3, "spill": 1, "spillWater": true, "pit": [0, 1], "debris": true, "debrisZ": -9.3, "cam": ["spillBottom", "spillBottom"]}},
    {"type": "dam", "say": "Поэтому внизу ставят ряды бетонных зубьев, чтобы её затормозить.",
     "props": {"cont": true, "core": 1, "grout": 1, "level": 6.3, "spill": 1, "spillWater": true, "pit": [1, 0], "baffles": [0, 1], "foam": true, "cam": ["spillBottom", "spillBottom"]}},
    {"type": "dam", "say": "Это гасители. Но теперь рыба не может подняться вверх по реке —",
     "props": {"cont": true, "core": 1, "grout": 1, "level": 6.3, "spill": 1, "spillWater": true, "baffles": 1, "foam": true, "fish": "blocked", "cam": ["spillBottom", "ladder"], "camDur": 0.6}},
    {"type": "dam", "say": "поэтому для неё строят лестницу из маленьких бассейнов.",
     "props": {"cont": true, "core": 1, "grout": 1, "level": 6.3, "spill": 1, "spillWater": true, "baffles": 1, "foam": true, "ladder": [0, 1], "fish": "climb", "cam": ["ladder", "ladder"]}},
    {"type": "dam", "say": "Это рыбоход. А вся эта падающая вода — бесплатная энергия.",
     "props": {"cont": true, "core": 1, "grout": 1, "level": 6.3, "spill": 1, "spillWater": true, "baffles": 1, "foam": true, "ladder": 1, "fish": "climb", "cam": ["ladder", "turbine"], "camDur": 0.8}},
    {"type": "dam", "say": "Поэтому часть пускают по трубе, чтобы крутить турбину.",
     "props": {"cont": true, "core": 1, "grout": 1, "level": 6.3, "spill": 1, "spillWater": true, "baffles": 1, "foam": true, "ladder": 1, "fish": "climb", "turbine": [0, 1], "cam": ["turbine", "turbine"]}},
    {"type": "dam", "say": "Добавь дорогу сверху и забор по краю.",
     "props": {"cont": true, "core": 1, "grout": 1, "level": 6.3, "spill": 1, "spillWater": true, "baffles": 1, "foam": true, "ladder": 1, "fish": "climb", "turbine": 1, "road": [0, 1], "fence": [0, 1], "fenceDelay": 0.4, "cam": ["turbine", "final"], "camDur": 0.7}},
    {"type": "dam", "say": "Поздравляю! Ты построил плотину. Подпишись.",
     "props": {"cont": true, "core": 1, "grout": 1, "level": 6.3, "spill": 1, "spillWater": true, "baffles": 1, "foam": true, "ladder": 1, "fish": "climb", "turbine": 1, "road": 1, "fence": 1, "banner": "Плотина построена!", "bannerAt": 0.1, "cam": ["final", "finalWide"]}}
  ]
}
