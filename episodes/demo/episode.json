{
  "title": "Тест конвейера (не для публикации)",
  "accent": "#FF3D8B",
  "demoVoice": true,
  "music": true,
  "scenes": [
    {
      "type": "hook",
      "say": "[удивлённо] Под землёй есть холодильник, который работает без розетки.",
      "props": {"text": "Холодильник *без розетки*", "sub": "и он под землёй"}
    },
    {
      "type": "draw",
      "say": "Смотрите на разрез. Наверху дом, а под ним, на глубине двух с половиной метров, комната.",
      "props": {"preset": "cellar", "title": "Разрез"}
    },
    {
      "type": "model3d",
      "say": "Земля работает как огромное одеяло. Летом она не пускает жару, а зимой не пускает мороз.",
      "props": {"primitive": "cellar", "cutaway": true, "title": "Земля — *одеяло*"}
    },
    {
      "type": "number",
      "say": "Поэтому внутри почти всегда около четырёх градусов.",
      "props": {"value": 4, "prefix": "+", "suffix": "°C", "label": "*круглый год*"}
    },
    {
      "type": "physics2d",
      "say": "Туда складывают весь урожай, и он лежит до самой весны.",
      "props": {"items": ["🥔", "🥕", "🍎", "🧅"], "count": 45, "label": "Весь *урожай*"}
    },
    {
      "type": "physics3d",
      "say": "Сотня банок с заготовками помещается без проблем.",
      "props": {"count": 100, "shape": "box", "size": 0.17, "label": "*100* банок"}
    },
    {
      "type": "image",
      "say": "Снаружи может быть минус тридцать.",
      "props": {"src": "frost.jpg", "title": "Снаружи *−30*"}
    },
    {
      "type": "image",
      "say": "А внутри всё равно плюс четыре.",
      "props": {"src": "cave.jpg", "title": "Внутри *+4*", "transition": "directionalwarp"}
    },
    {
      "type": "video",
      "say": "И никакого электричества. Только физика.",
      "props": {"src": "clip.mp4"}
    },
    {
      "type": "outro",
      "say": "Подпишись, тут объясняют, как всё устроено.",
      "props": {}
    }
  ]
}
